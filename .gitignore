/node_modules/
*.log
.DS_Store

# The bundles in js/ are built, not committed: the release build puts them
# into the release archive, a test instance runs `npm run build`.
# js/pulse-embed.js is hand-written (not a webpack entry) and stays.
/js/*
!/js/pulse-embed.js

# Throwaway test scripts (DB harnesses against the running instance, see tests/README.md)
/_*.php

# Release archives of earlier releases, kept in the main checkout
/build/pulse-*.tar.gz

# Cached App Store schema for the info.xml check
/build/info.xsd

# Key material for the app signature never belongs in the repository
*.key
*.csr
*.crt

# The PHPUnit PHAR and geckodriver are downloaded on demand and do not belong in the repository
/tools/

# Design screenshots: images, probe data and the throwaway user's password
/dev/design-shots/out/
/dev/design-shots/out-*/
/dev/design-shots/probe.json
/dev/design-shots/pace.json
/dev/design-shots/store.json
/dev/design-shots/.host
/dev/design-shots/.store-host
/dev/design-shots/.shots-pass
.phpunit.cache/
.phpunit.result.cache
