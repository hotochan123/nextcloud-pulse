{
  "name": "pulse",
  "version": "0.18.0",
  "description": "Live-Umfragen für Präsentationen in Nextcloud",
  "scripts": {
    "build": "webpack --node-env production --config webpack.config.js",
    "l10n": "node build/l10n-build.js",
    "l10n:check": "node build/l10n-check.js",
    "dev": "webpack --node-env development --config webpack.config.js",
    "watch": "webpack --node-env development --watch --config webpack.config.js"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.5.0",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^8.11.2",
    "qrcode-generator": "^1.4.4",
    "vue": "^2.7.16",
    "vuedraggable": "^2.24.3"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/webpack-vue-config": "^6.1.0",
    "terser-webpack-plugin": "^5.6.1",
    "vue-loader": "^15.11.1",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.91.0"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ]
}
